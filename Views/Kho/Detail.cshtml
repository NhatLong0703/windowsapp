@model List<TonRow>
@{
    var kho = (KhoRow)ViewBag.Kho;
    var recent = (List<PhieuRow>)ViewBag.Recent;
    string? tt = ViewBag.Tt;
    ViewData["Title"] = kho.TenKho;
    string Tab(string? v) => tt == v ? "tab on" : "tab";
    int soCanNhap = (int)ViewBag.CountSap + (int)ViewBag.CountHet;
}
<div class="page-h">
    <div>
        <div class="eyebrow">KHO HÀNG</div>
        <h1>@kho.TenKho</h1>
        <p class="muted">@(string.IsNullOrEmpty(kho.DiaChi) ? "Chưa có địa chỉ" : kho.DiaChi)@(string.IsNullOrEmpty(kho.SoDienThoai) ? "" : " · " + kho.SoDienThoai) · Thủ kho: @(string.IsNullOrEmpty(kho.ThuKho) ? "chưa phân công" : kho.ThuKho)</p>
    </div>
    <div style="display:flex;gap:10px">
        <a class="btn" asp-action="Index">← Danh sách kho</a>
        <a class="btn" asp-controller="Phieu" asp-action="Form" asp-route-loai="xuat" asp-route-maKho="@kho.MaKho">@Ui.Icon("out") Xuất hàng</a>
        <a class="btn btn-primary" asp-controller="Phieu" asp-action="Form" asp-route-loai="nhap" asp-route-maKho="@kho.MaKho">@Ui.Icon("in") Nhập hàng vào kho</a>
    </div>
</div>

<div class="stats">
    <div class="card stat"><div class="stat-t">Mặt hàng còn hàng <i class="chip blue">@Ui.Icon("box")</i></div><div class="stat-v">@Fmt.Num(kho.SoMatHang)</div><div class="muted">trên @ViewBag.CountAll mặt hàng đã giao dịch</div></div>
    <div class="card stat"><div class="stat-t">Tổng số lượng tồn <i class="chip green">@Ui.Icon("warehouse")</i></div><div class="stat-v">@Fmt.Num(kho.TongTon)</div><div class="muted">cộng theo từng mặt hàng</div></div>
    <div class="card stat"><div class="stat-t">Giá trị tồn <i class="chip purple">@Ui.Icon("grid")</i></div><div class="stat-v">@Fmt.Short(kho.GiaTri) <small>đ</small></div><div class="muted">tính theo đơn giá danh mục</div></div>
    <div class="card stat"><div class="stat-t">Cần nhập thêm <i class="chip orange">@Ui.Icon("bell")</i></div><div class="stat-v">@soCanNhap</div><div class="muted">@ViewBag.CountSap sắp hết · @ViewBag.CountHet hết hàng</div></div>
</div>

<div class="card">
    <div class="tabs">
        <a class="@Tab(null)" asp-action="Detail" asp-route-id="@kho.MaKho" asp-route-q="@ViewBag.Q">Tất cả (@ViewBag.CountAll)</a>
        <a class="@Tab("on")" asp-action="Detail" asp-route-id="@kho.MaKho" asp-route-tt="on" asp-route-q="@ViewBag.Q">Ổn định (@ViewBag.CountOn)</a>
        <a class="@Tab("sap")" asp-action="Detail" asp-route-id="@kho.MaKho" asp-route-tt="sap" asp-route-q="@ViewBag.Q">Sắp hết (@ViewBag.CountSap)</a>
        <a class="@Tab("het")" asp-action="Detail" asp-route-id="@kho.MaKho" asp-route-tt="het" asp-route-q="@ViewBag.Q">Hết hàng (@ViewBag.CountHet)</a>
    </div>
    <form class="toolbar" method="get">
        <input type="hidden" name="tt" value="@tt" />
        <input name="q" value="@ViewBag.Q" placeholder="Tìm sản phẩm trong kho này..." /><button class="btn">Tìm</button>
    </form>
    <div class="tbl-wrap"><table class="tbl">
        <thead><tr><th>SẢN PHẨM</th><th class="r">TỒN</th><th class="r">TỐI THIỂU</th><th class="r">ĐƠN GIÁ</th><th class="r">GIÁ TRỊ</th><th>TRẠNG THÁI</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in Model)
        {
            var st = r.Ton <= 0 ? ("Hết hàng", "bad") : r.Ton <= r.TonToiThieu ? ("Sắp hết", "warn") : ("Ổn định", "ok");
            <tr>
                <td><b>@r.TenSP</b><div class="muted sm">@Fmt.MaSP(r.MaSP)</div></td>
                <td class="r"><b>@Fmt.Num(r.Ton)</b> @r.DonViTinh</td>
                <td class="r">@r.TonToiThieu</td>
                <td class="r">@Fmt.Money(r.DonGia)</td>
                <td class="r">@Fmt.Money(r.Ton > 0 ? r.Ton * r.DonGia : 0)</td>
                <td><span class="badge @st.Item2">@st.Item1</span></td>
                <td class="acts">
                    <a class="btn" asp-controller="Phieu" asp-action="Form" asp-route-loai="nhap" asp-route-maKho="@kho.MaKho" asp-route-maSP="@r.MaSP">Nhập thêm</a>
                    <a class="btn" asp-controller="Phieu" asp-action="Form" asp-route-loai="xuat" asp-route-maKho="@kho.MaKho" asp-route-maSP="@r.MaSP">Xuất</a>
                </td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="7" class="muted center">Chưa có hàng nào khớp. Bấm "Nhập hàng vào kho" để đưa sản phẩm vào kho này.</td></tr> }
        </tbody>
    </table></div>
</div>

<div class="card">
    <div class="card-h"><div><h3>Phiếu nhập - xuất gần đây của kho</h3><p class="muted">8 phiếu mới nhất</p></div>
        <div style="display:flex;gap:10px">
            <a class="btn" asp-controller="Phieu" asp-action="Index" asp-route-loai="nhap" asp-route-maKho="@kho.MaKho">Tất cả phiếu nhập</a>
            <a class="btn" asp-controller="Phieu" asp-action="Index" asp-route-loai="xuat" asp-route-maKho="@kho.MaKho">Tất cả phiếu xuất</a>
        </div></div>
    <div class="tbl-wrap"><table class="tbl">
        <thead><tr><th>MÃ PHIẾU</th><th>LOẠI</th><th>NGÀY</th><th>ĐỐI TÁC / GHI CHÚ</th><th>NGƯỜI TẠO</th><th class="r">GIÁ TRỊ</th></tr></thead>
        <tbody>
        @foreach (var p in recent)
        {
            <tr>
                <td><a class="lnk" asp-controller="Phieu" asp-action="Form" asp-route-loai="@p.Loai" asp-route-id="@p.Id"><b>@p.Ma</b></a></td>
                <td>@if (p.Loai == "nhap") { <span class="badge ok">Nhập</span> } else { <span class="badge warn">Xuất</span> }</td>
                <td>@Fmt.Date(p.Ngay)</td>
                <td>@(p.DoiTac ?? p.GhiChu ?? "—")</td>
                <td>@p.NguoiTao</td>
                <td class="r">@Fmt.Money(p.GiaTri)</td>
            </tr>
        }
        @if (recent.Count == 0) { <tr><td colspan="6" class="muted center">Chưa có phiếu nào.</td></tr> }
        </tbody>
    </table></div>
</div>
