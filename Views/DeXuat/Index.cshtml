@model List<WebApplication1.Models.DeXuatRow>
@{
    ViewData["Title"] = "Duyệt đề xuất sản phẩm";
    var khos = (IEnumerable<WebApplication1.Models.Kho>)ViewBag.Khos;
    var cho = Model.Count(x => x.TrangThai == "ChoDuyet");
}
<partial name="_DeXuatStyle" />

<div class="page-h">
    <div><div class="eyebrow">QUẢN LÝ</div><h1>Duyệt đề xuất sản phẩm</h1></div>
</div>

<div class="card">
    <div class="card-h"><div><h3>Đề xuất từ nhà cung cấp</h3><p class="muted">@cho đề xuất đang chờ duyệt. Duyệt có số lượng và kho thì hàng vào thẳng kho.</p></div></div>
    <div class="tbl-wrap">
        <table class="tbl">
            <thead><tr><th>NHÀ CUNG CẤP</th><th>SẢN PHẨM</th><th>LOẠI</th><th>XỬ LÝ</th></tr></thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td><b>@d.TenNCC</b><div class="muted sm">@Fmt.Date(d.NgayTao)</div></td>
                        <td><b>@d.TenSP</b>@if (!string.IsNullOrEmpty(d.DonViTinh)) { <span class="muted"> (@d.DonViTinh)</span> }<div class="muted sm">@d.MoTa</div></td>
                        <td>@d.TenLoai</td>
                        <td>
                            @if (d.TrangThai == "ChoDuyet")
                            {
                                <form method="post" asp-action="Duyet" class="dx-row">
                                    <input type="hidden" name="maDX" value="@d.MaDX" />
                                    <input name="donGia" type="number" min="0" value="@d.DonGia.ToString("0")" class="dx-in" style="width:110px" title="Đơn giá" />
                                    <input name="soLuong" type="number" min="0" value="@d.SoLuong" class="dx-in" style="width:80px" title="Số lượng" />
                                    <select name="maKho" class="dx-in" style="width:150px">
                                        <option value="">-- Kho --</option>
                                        @foreach (var k in khos) { <option value="@k.MaKho" selected="@(k.MaKho == d.MaKho)">@k.TenKho</option> }
                                    </select>
                                    <button class="dx-btn ok sm">Duyệt</button>
                                </form>
                                <form method="post" asp-action="TuChoi" class="dx-row">
                                    <input type="hidden" name="maDX" value="@d.MaDX" />
                                    <input name="lyDo" placeholder="Lý do từ chối" class="dx-in" maxlength="200" />
                                    <button class="dx-btn no sm">Từ chối</button>
                                </form>
                            }
                            else if (d.TrangThai == "DaDuyet")
                            {
                                <span class="dx-badge ok">Đã duyệt</span>
                                @if (d.MaPNTao != null) { <span class="muted sm"> PN-@d.MaPNTao.Value.ToString("00000")</span> }
                            }
                            else if (d.TrangThai == "TuChoi") { <span class="dx-badge no">Từ chối</span> <div class="muted sm">@d.LyDoTuChoi</div> }
                            else { <span class="dx-badge off">NCC đã hủy</span> }
                        </td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="4" class="muted center">Chưa có đề xuất nào.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
