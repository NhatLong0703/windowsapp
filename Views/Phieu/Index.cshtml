@model List<PhieuRow>
@{
    string loai = ViewBag.Loai;
    var nhap = loai == "nhap";
    ViewData["Title"] = nhap ? "Phiếu nhập" : "Phiếu xuất";
    var khos = (List<Kho>)ViewBag.Khos;
    int? selKho = ViewBag.MaKho;
}
<div class="page-h">
    <div><div class="eyebrow">NGHIỆP VỤ KHO</div><h1>@ViewData["Title"]</h1></div>
</div>
<div class="card">
    <form class="toolbar" method="get">
        <input type="hidden" name="loai" value="@loai" />
        <input name="q" value="@ViewBag.Q" placeholder="Tìm mã phiếu, kho, @(nhap ? "đối tác, " : "")người tạo..." />
        @if (User.IsAdmin())
        {
            <select name="maKho"><option value="">Tất cả kho</option>@foreach (var k in khos) { <option value="@k.MaKho" selected="@(selKho == k.MaKho)">@k.TenKho</option> }</select>
        }
        else
        {
            <span class="badge ok">Kho: @khos.FirstOrDefault()?.TenKho</span>
        }
        <label class="inl">Từ <input type="date" name="tu" value="@ViewBag.Tu" /></label>
        <label class="inl">Đến <input type="date" name="den" value="@ViewBag.Den" /></label>
        <button class="btn">Lọc</button>
    </form>
    <div class="tbl-wrap"><table class="tbl">
        <thead><tr><th>MÃ PHIẾU</th><th>NGÀY</th><th>KHO</th>@if (nhap) {<th>ĐỐI TÁC</th>}<th>NGƯỜI TẠO</th><th>GHI CHÚ</th><th class="r">GIÁ TRỊ</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td><a class="lnk" asp-action="Detail" asp-route-loai="@loai" asp-route-id="@p.Id"><b>@p.Ma</b></a></td>
                <td>@Fmt.Date(p.Ngay)</td><td>@p.TenKho</td>
                @if (nhap) { <td>@p.DoiTac</td> }
                <td>@p.NguoiTao</td><td class="muted">@p.GhiChu</td>
                <td class="r"><b>@Fmt.Money(p.GiaTri)</b></td>
                <td class="acts">
                    <a class="btn" asp-action="Detail" asp-route-loai="@loai" asp-route-id="@p.Id">Xem</a>
                    @if (ViewBag.CoTheSua == true)
                    {
                        <form method="post" asp-action="Delete" asp-route-loai="@loai" asp-route-id="@p.Id" onsubmit="return confirm('Xóa phiếu @(p.Ma)?')"><button class="icon-act danger" title="Xóa">@Ui.Icon("trash")</button></form>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="8" class="muted center">Chưa có phiếu nào.</td></tr> }
        </tbody>
        @if (Model.Count > 0)
        {
            <tfoot><tr><td colspan="@(nhap ? 6 : 5)"><b>@Model.Count phiếu</b></td><td class="r"><b>@Fmt.Money(Model.Sum(x => x.GiaTri))</b></td><td></td></tr></tfoot>
        }
    </table></div>
</div>
