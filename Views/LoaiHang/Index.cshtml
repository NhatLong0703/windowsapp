@model List<LoaiHang>
@{ ViewData["Title"] = "Loại hàng"; }
<div class="page-h">
    <div><div class="eyebrow">DANH MỤC</div><h1>Loại hàng</h1></div>
    <button class="btn btn-primary" onclick="openForm('dlg')">@Ui.Icon("plus") Thêm loại hàng</button>
</div>
<div class="card"><div class="tbl-wrap"><table class="tbl">
    <thead><tr><th>TÊN LOẠI HÀNG</th><th class="r">SỐ SẢN PHẨM</th><th></th></tr></thead>
    <tbody>
    @foreach (var l in Model)
    {
        <tr>
            <td><b>@l.TenLoai</b></td><td class="r">@l.SoSP</td>
            <td class="acts">
                <button class="icon-act" title="Sửa" data-item="@JsonSerializer.Serialize(l)" onclick="openForm('dlg', this)">@Ui.Icon("edit")</button>
                <form method="post" asp-action="Delete" asp-route-id="@l.MaLoai" onsubmit="return confirm('Xóa loại hàng này? Sản phẩm thuộc loại này sẽ thành chưa phân loại.')"><button class="icon-act danger" title="Xóa">@Ui.Icon("trash")</button></form>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="3" class="muted center">Chưa có loại hàng nào.</td></tr> }
    </tbody>
</table></div></div>
<dialog class="dlg" id="dlg">
    <form method="post" asp-action="Save">
        <h3 data-new="Thêm loại hàng" data-edit="Sửa loại hàng"></h3>
        <input type="hidden" name="MaLoai" value="0" />
        <label class="field">Tên loại hàng<input name="TenLoai" required /></label>
        <div class="dlg-f"><button type="button" class="btn" onclick="this.closest('dialog').close()">Hủy</button><button class="btn btn-primary">Lưu</button></div>
    </form>
</dialog>
